---
import Layout from "@/layouts/Layout.astro";
import heroKeyLogo from "@/assets/hero-key-background.webp";
---

<Layout>
	<div id="logo-mask" class="fixed top-0 w-full h-screen">
		<section>
			<picture
				id="hero-key"
				class="h-screen w-full scale-115 block overflow-hidden fixed"
			>
				<img
					id="hero-key-logo"
					src={heroKeyLogo.src}
					class="w-full h-full object-cover"
				/>
			</picture>
		</section>
	</div>
	<div class="fixed flex h-screen *:items-center justify-center w-full p-40">
		<h1 id="hero-title" class=" "></h1>
	</div>
</Layout>

<style>
	#logo-mask {
		background: white;
		mask-image: url("/belen1.svg");
		mask-position: center 49%;
		mask-repeat: no-repeat;
		mask-size: clamp(7000vh, 5000%, 0vh);
	}
		#hero-title {
		background: white;
		mask-image: url("/Letra.svg");
		mask-position: center 50%;
		mask-repeat: no-repeat;
		/* mask-size: clamp(7000vh, 5000%, 0vh); */
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);
	const tl = gsap
		.timeline({
			ease: "power1.inOut",
			scrollTrigger: {
				scrub: 1,
			},
		})
		.to("#logo-mask", {
			maskSize: "clamp(20vh, 25%, 30vh)",
			duration: 0.2,
		})
		.to(
			"#hero-key",
			{
				scale: 1,
				opacity: 0,
				duration: 0.2,
			},
			"<",
		)

		.to(
			"#logo-mask",
			{
				transform: "translateY(-35%)",
				duration: 0.4,
			},
			"<",
		);
</script>
