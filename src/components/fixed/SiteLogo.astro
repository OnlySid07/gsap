---

<a
	href="#intro"
	class="site-logo pointer-events-auto w-[min(42vw,230px)] shrink-0"
	aria-label="Belen's Version"
>
	<picture>
		<source
			type="image/webp"
			srcset="/images/logo-600.webp 600w, /images/logo-1200.webp 1200w"
			sizes="(min-width: 768px) 230px, 42vw"
		/>
		<img
			src="/images/logo.png"
			alt="Belen's Version"
			width="1200"
			height="638"
			class="h-auto w-full"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	</picture>
</a>

<style>
	@media (max-height: 480px) {
		.site-logo {
			width: min(42vw, 230px, 28vh);
		}
	}
</style>
