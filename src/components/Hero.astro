<section data-hero id="intro" class="relative h-[520vh]">
    <div data-hero-stage class="sticky top-0 h-screen w-full overflow-hidden ">
        <div data-hero-media class="absolute inset-0">
            <video
            data-hero-video
            class="absolute inset-0 h-full w-full object-fill aspect-auto "
            muted
            playsinline
            preload="auto"
            aria-hidden="true"
            >
            <source src="/videos/lover-1920-1.mp4" type="video/mp4" />
            <!-- <source src="/videos/style-854-1.webm" type="video/webm" /> -->
        </video>
    </div>
</div>

</section>
<script>
    import {$} from "@/lib/dom";
    import {onLoadingReady } from "@/lib/loading"

    const $video = $("[data-hero-video]") as HTMLVideoElement | null;

    const playHero = (video: HTMLVideoElement) => {
        const attempt = () => {
            video.play().catch((error) => {
                console.error("Error al reproducir el video:", error);
            });
        };

        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
            attempt();
            return;
        }

        video.addEventListener("canplay", attempt, { once: true });
        video.load();
    };

    if ($video) {
        $video.load();
        onLoadingReady(() => playHero($video));
    }
</script>